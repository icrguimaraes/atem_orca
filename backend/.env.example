# Copie para .env em desenvolvimento. No Railway, configure como variáveis do serviço.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/atem
SECRET_KEY=troque-por-um-valor-aleatorio-de-64-caracteres
ENVIRONMENT=development
ADMIN_EMAIL=admin@atem.com.br
ADMIN_PASSWORD=defina-uma-senha-forte
UPLOAD_DIR=./data/uploads
RUN_IMPORT_WORKER=true
CORS_ORIGINS=*
MAX_UPLOAD_MB=50

# SAP HANA (KSB1). No Railway só SAP_PUSH_TOKEN é necessário (recebe o envio do script). No computador de quem
# acessa o HANA, tudo abaixo vai no backend/.env (arquivo ignorado pelo git): rode `scripts\sap-ksb1.cmd teste`.
HANA_HOST=
HANA_USER=
HANA_PASSWORD=
SAP_PUSH_TOKEN=
SAP_PUSH_URL=https://atemorca-production.up.railway.app
