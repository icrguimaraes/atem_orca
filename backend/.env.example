# Copie para .env em desenvolvimento. No Railway, configure como variáveis do serviço.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/atem
SECRET_KEY=troque-por-um-valor-aleatorio-de-64-caracteres
ENVIRONMENT=development
ADMIN_EMAIL=admin@atem.com.br
ADMIN_PASSWORD=defina-uma-senha-forte
UPLOAD_DIR=./data/uploads
RUN_IMPORT_WORKER=true
CORS_ORIGINS=*
MAX_UPLOAD_MB=50
